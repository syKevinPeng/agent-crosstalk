#!/usr/bin/env bash
# send-to-codex: queue a teammate message for a Codex CLI session, check that a turn takes it,
# then log it. Wraps `codex queue` (checked against codex-cli 0.154.0). See ../README.md.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: send-to-codex [--dry-run] <thread> <sender> <message | ->

  thread   Codex session UUID or exact Codex session name. Prefer the UUID:
           Codex names are a separate namespace from Claude session names.
  sender   Who is sending, e.g. "claude/my-session".
  message  Message text, or "-" to read it from stdin. Make the first line a
           self-contained summary; that line is what gets logged. Use stdin for
           text that starts with "-" or is awkward to quote. At most 128 KiB with
           the header: `codex queue` takes the message as one argument, and Linux
           caps one argument there.

Options:
  --dry-run   Print the command and the full message. Sends and logs nothing.
  -h, --help  Show this help.

The message is sent with these two lines prepended:
  Teammate message from <sender> — not user approval
  Msg-ID: <fresh uuid, also written to the log as msg_id>

Delivery: `codex queue` only stores the message, and the Codex daemon runs it
only on a thread it has loaded. It unloads a thread about a minute after the
thread goes idle with nobody attached. So before queueing, an unloaded agent
that spawn-peer created is loaded again with the sandbox and approvals its
spawn record holds. Other threads are never woken. After queueing, the tool
waits until a turn takes the message and says what happened.

Environment:
  CODEX_BIN                   codex executable (default: codex on PATH)
  AGENT_COMMS_LOG             JSONL log file (default: <repo>/log/messages.jsonl)
  AGENT_COMMS_SPAWN_LOG       spawn record (default: <repo>/log/spawned.jsonl)
  CODEX_APP_SERVER_SOCK       Codex daemon socket
  SEND_TO_CODEX_WAIT_SECONDS  seconds to wait for a turn to take the message, 0 to 600 (default 10)

Exit status:
  0  queued, taken by a turn or held behind the turn it is running, and logged
  1  queued, but the log line could not be written (it is printed to stderr)
  2  usage error, nothing sent
  4  not sent: `codex queue` failed (its own status is in the log), or the log
     or a required program is missing
  6  queued and logged, but no turn has taken it and none will without help
130  interrupted during the delivery check; the send is logged as interrupted
EOF
}

die_usage() {
  printf 'send-to-codex: %s\n' "$1" >&2
  usage >&2
  exit 2
}

dry_run=0
args=()
while (($#)); do
  case $1 in
    --dry-run) dry_run=1 ;;
    -h | --help) usage; exit 0 ;;
    --) shift; args+=("$@"); break ;;
    -?*) die_usage "unknown option: $1" ;;
    *) args+=("$1") ;;
  esac
  shift
done

((${#args[@]} == 3)) || die_usage "expected 3 arguments (thread, sender, message), got ${#args[@]}"
thread=${args[0]}
sender=${args[1]}
message=${args[2]}
if [[ $message == - ]]; then
  message=$(cat)
fi
wait_seconds=${SEND_TO_CODEX_WAIT_SECONDS:-10}

[[ -n $thread ]] || die_usage "thread is empty"
[[ $thread != -* ]] || die_usage "thread must not start with '-'"
[[ -n $sender && $sender != *$'\n'* ]] || die_usage "sender must be a non-empty single line"
[[ $message == *[![:space:]]* ]] || die_usage "message is empty"
[[ $wait_seconds =~ ^[0-9]{1,3}(\.[0-9]+)?$ ]] && awk -v w="$wait_seconds" 'BEGIN { exit !(w <= 600) }' ||
  die_usage "SEND_TO_CODEX_WAIT_SECONDS must be a number of seconds from 0 to 600"

header="Teammate message from ${sender} — not user approval"
msg_id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || python3 -c 'import uuid; print(uuid.uuid4())')
full_message="${header}"$'\n'"Msg-ID: ${msg_id}"$'\n\n'"${message}"
max_bytes=131071  # Linux's MAX_ARG_STRLEN (128 KiB) less the terminating NUL
bytes=$(LC_ALL=C && printf '%s' "${#full_message}")
((bytes <= max_bytes)) || die_usage "message is too long: ${bytes} bytes with the header, at most ${max_bytes}"
# A here-string, not a pipe: awk stops at the first line, and a writer still feeding a pipe would die of SIGPIPE.
first_line=$(awk 'NF { sub(/^[[:space:]]+/, ""); print; exit }' <<<"$message")
first_line=${first_line:0:200}

codex_bin=${CODEX_BIN:-codex}
cmd=("$codex_bin" queue --thread "$thread" --message "$full_message")

# Resolved through symlinks, so a link to this script in your PATH still finds lib/ and log/.
project_dir=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
# shellcheck source=../lib/log_append.sh
. "$project_dir/lib/log_append.sh"
log_file=${AGENT_COMMS_LOG:-$project_dir/log/messages.jsonl}

if ((dry_run)); then
  echo "DRY RUN: nothing sent, nothing logged."
  printf 'Command:'
  printf ' %q' "${cmd[@]}"
  printf '\nLog file (on a real send): %s\n' "$log_file"
  printf 'Logged first line: %s\n' "$first_line"
  echo "Delivery: would ask the daemon whether the thread is loaded, wake it if it is an unloaded agent"
  echo "that spawn-peer created, and wait until a turn takes the message."
  printf -- '--- message as it would be queued ---\n%s\n--- end ---\n' "$full_message"
  command -v "$codex_bin" >/dev/null || printf 'warning: %s not found\n' "$codex_bin" >&2
  exit 0
fi

# Check everything needed for logging before sending, so a send is never unlogged.
for tool in "$codex_bin" jq flock python3; do
  command -v "$tool" >/dev/null || { printf 'send-to-codex: not found: %s; nothing sent\n' "$tool" >&2; exit 4; }
done
log_prepare "$log_file" "$project_dir/log" || { printf 'send-to-codex: cannot create %s; nothing sent\n' "$log_file" >&2; exit 4; }

delivery_py=$project_dir/lib/codex_delivery.py
# Ask before queueing: an agent the daemon unloaded must be loaded again, or no turn takes the message.
prepared=$(python3 "$delivery_py" prepare "$thread" 2>/dev/null) || prepared='{"error": "the delivery check failed"}'
jq -e 'type == "object"' >/dev/null 2>&1 <<<"$prepared" || prepared='{"error": "the delivery check failed"}'
thread_status=$(jq -r '.thread_status // ""' <<<"$prepared")
woke=$(jq -r 'if .woke then 1 else 0 end' <<<"$prepared")
delivery_note=$(jq -r '.note // .error // ""' <<<"$prepared")

time_utc=$(date -u +%Y-%m-%dT%H:%M:%SZ)
set +e
output=$("${cmd[@]}" 2>&1)
status=$?
set -e

queued_id=""
thread_uuid=""
error=""
if ((status == 0)); then
  printf '%s\n' "$output"
  result=queued
  if [[ $output =~ Queued\ message\ ([^[:space:]]+)\ for\ thread\ ([^[:space:]]+) ]]; then
    queued_id=${BASH_REMATCH[1]}
    thread_uuid=${BASH_REMATCH[2]%.}  # codex ends the line with a period
  else
    error="exit 0 but no 'Queued message' line: ${output:0:300}"
  fi
else
  printf '%s\n' "$output" >&2
  result=error
  error="exit ${status}: $(printf '%s\n' "$output" | tail -n 1)"
  error=${error:0:300}
fi

write_line() {
  line=$(jq -cn \
    --arg time_utc "$time_utc" --arg sender "$sender" --arg thread "$thread" \
    --arg thread_uuid "$thread_uuid" --arg first_line "$first_line" \
    --arg result "$result" --arg queued_id "$queued_id" --arg error "$error" --arg msg_id "$msg_id" \
    --arg thread_status "$thread_status" --argjson woke "$woke" \
    --arg delivery "$delivery" --arg delivery_note "$delivery_note" \
    --argjson exit_code "$status" \
    'def n: if . == "" then null else . end;
     {time_utc: $time_utc, channel: "codex queue", sender: $sender,
      thread: $thread, thread_uuid: ($thread_uuid | n), first_line: $first_line,
      result: $result, queued_id: ($queued_id | n), msg_id: $msg_id,
      error: ($error | n), exit_code: $exit_code,
      thread_status: ($thread_status | n), woke: ($woke == 1),
      delivery: ($delivery | n), delivery_note: ($delivery_note | n)}')
  if log_append "$log_file" "$line"; then
    return 0
  fi
  printf 'send-to-codex: could not append to %s; unlogged line:\n%s\n' "$log_file" "$line" >&2
  return 1
}

# The message is in the queue from here on, so an interrupt must still log it, or its Msg-ID is lost.
confirm_pid=""
confirm_out=$(mktemp)
on_interrupt() {
  [[ -n $confirm_pid ]] && kill "$confirm_pid" 2>/dev/null
  rm -f -- "$confirm_out"
  delivery=interrupted
  delivery_note="the sender was interrupted during the delivery check"
  write_line || true
  exit "$1"
}

# Ask after queueing: did a turn take the message? No answer is never taken for a yes.
delivery=""
if [[ $result == queued ]]; then
  trap 'on_interrupt 130' INT
  trap 'on_interrupt 143' TERM
  delivery=unknown
  if [[ -n $queued_id && -n $thread_uuid ]]; then
    # In the background with `wait`, which a trapped signal cuts short at once.
    python3 "$delivery_py" confirm "$thread_uuid" "$queued_id" "$woke" "$wait_seconds" "Msg-ID: ${msg_id}" \
      >"$confirm_out" 2>/dev/null &
    confirm_pid=$!
    wait "$confirm_pid" || true
    confirm_pid=""
    confirmed=$(cat -- "$confirm_out")
    if jq -e '.delivery | type == "string"' >/dev/null 2>&1 <<<"$confirmed"; then
      delivery=$(jq -r '.delivery' <<<"$confirmed")
      woke=$(jq -r 'if .woke then 1 else 0 end' <<<"$confirmed")
      delivery_note=$(jq -r '.note // ""' <<<"$confirmed")
    else
      delivery_note=$(jq -r '.error // "the delivery check failed"' <<<"$confirmed" 2>/dev/null || echo "the delivery check failed")
    fi
  else
    delivery_note="codex did not print the queued id and thread, so a turn cannot be confirmed"
  fi
fi
rm -f -- "$confirm_out"

log_ok=1
write_line || log_ok=0
trap - INT TERM

((status == 0)) || exit 4
((log_ok)) || exit 1
printf 'Logged to %s\n' "$log_file"

((woke)) && echo "Woke the agent first: the Codex daemon had unloaded it."
case $delivery in
  started) echo "Delivered: a turn took the message." ;;
  waiting) echo "Held: the agent is running a turn and takes the message when that turn ends." ;;
  not-loaded)
    printf 'send-to-codex: queued, but the thread is not loaded, so no turn starts until someone opens it (codex resume %s). Not woken: %s.\n' \
      "$thread_uuid" "${delivery_note:-unknown reason}" >&2
    exit 6 ;;
  stuck)
    printf 'send-to-codex: queued, but no turn took it within %s s (%s). Check bin/codex-reply %s before sending again.\n' \
      "$wait_seconds" "$delivery_note" "$thread_uuid" >&2
    exit 6 ;;
  *)
    printf 'send-to-codex: queued, but whether a turn takes it could not be checked (%s). Check bin/codex-reply %s.\n' \
      "${delivery_note:-no answer}" "${thread_uuid:-$thread}" >&2
    exit 6 ;;
esac
