#!/usr/bin/env python3
"""agent-menu-detail: the popup for one agent. Shows what it waits on, its spawned agents and its
recent messages, and lets the owner open its pane, attach, send an instruction or retire it.
The actions run only from this interactive screen. See ../README.md, "Agent menu"."""
import argparse
import curses
import locale
import os
import subprocess
import sys
import time

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lib"))
import agent_state  # noqa: E402
import auth_readers  # noqa: E402
import menu_actions  # noqa: E402
import menu_curses  # noqa: E402
import menu_detail  # noqa: E402
import menu_popup  # noqa: E402
import menu_render  # noqa: E402
import menu_style  # noqa: E402
from sources import logs_src  # noqa: E402
from sources.base import SourceError  # noqa: E402

RELOAD_MS = 1500
KEY_NAMES = {curses.KEY_ENTER: "enter", curses.KEY_BACKSPACE: "backspace", curses.KEY_BTAB: "backtab",
             curses.KEY_LEFT: "left", curses.KEY_RIGHT: "right", curses.KEY_NPAGE: "pgdn", curses.KEY_PPAGE: "pgup"}
CHAR_KEYS = {"\x1b": "esc", "\n": "enter", "\r": "enter", "\t": "tab", "\x7f": "backspace", "\x08": "backspace"}


def load(key):
    """(agent, parent name, recent messages, latest answer, errors). `errors` names the sources that
    could not be read: when it is not empty, a missing agent may only be missing from this reading."""
    snapshot = agent_state.safe_collect()
    agent = snapshot.by_key.get(key)
    if not agent:
        return None, "", [], "", snapshot.errors
    parent = snapshot.by_key.get(agent.parent_key)
    try:
        recent = logs_src.recent(agent.session_id, agent.name)
    except SourceError:
        recent = []
    reply = ""
    if agent.kind == "codex" and not agent.pane_id:
        try:
            done = subprocess.run([sys.executable, os.path.join(BIN, "codex-reply"), agent.session_id],
                                  capture_output=True, text=True, timeout=5)
            reply = "\n".join(done.stdout.splitlines()[1:]).strip() if done.returncode in (0, 5) else ""
        except (OSError, subprocess.TimeoutExpired):
            reply = ""
        reply = "\n".join(agent_state.clean(line.replace("\t", " ")) for line in reply.splitlines())
        agent.auth = agent.auth or (auth_readers.detect_output(reply) or "")
    return agent, (parent.name if parent else ""), recent, reply, snapshot.errors


def reload(key, loaded):
    """A fresh reading, and a note that is empty unless the refresh failed. A reading that failed to
    list the agent while a source was unreadable keeps the last one: one failed refresh must not end
    the popup and the instruction being typed in it."""
    fresh = load(key)
    if fresh[0] is None and fresh[4] and loaded[0] is not None:
        return loaded, "not refreshed (" + "; ".join(fresh[4]) + "): showing the last reading"
    return fresh, ""


def read_event(screen):
    """One input event for menu_popup.step, or None on timeout, or "resize". A mouse report that is
    not a click, such as the release after a held press, is no event at all and is read past."""
    while True:
        try:
            got = screen.get_wch()
        except curses.error:
            return None
        if isinstance(got, str):
            return ("key", CHAR_KEYS[got]) if got in CHAR_KEYS else ("char", got)
        if got == curses.KEY_RESIZE:
            return "resize"
        if got == curses.KEY_MOUSE:
            spot = menu_curses.click()
            if spot:
                return ("mouse", spot)
            continue
        return ("key", KEY_NAMES.get(got, "other"))


def run(screen, key):
    colour = menu_curses.setup(screen)
    glyphs = menu_style.glyphs()
    screen.timeout(RELOAD_MS)
    state, note, stale = menu_popup.State(), "", ""
    loaded = load(key)
    while not state.close:
        agent, parent_name, recent, reply, errors = loaded
        height, width = screen.getmaxyx()
        columns = width - 1
        screen.erase()
        if not agent:
            gone = ("The agent list could not be read (" + "; ".join(errors) + ")." if errors
                    else "This agent is no longer listed.")
            menu_curses.put(screen, 1, 2, menu_render.fit(gone + " Press any key.", max(columns - 2, 1)))
            screen.noutrefresh()
            curses.doupdate()
            screen.timeout(-1)
            read_event(screen)
            return
        offered, spots = menu_detail.buttons(agent), []
        small = menu_render.too_small(height, width) or height < 9
        if small:
            menu_curses.put(screen, 0, 0, "too small")
        else:
            menu_curses.put(screen, 0, 2, menu_render.fit(menu_detail.title(agent, parent_name), columns - 4,
                                                          glyphs["ellipsis"]), curses.A_DIM)
            body = menu_detail.body(agent, recent, reply, columns - 4, glyphs)
            room = height - 7                               # title, gap, input, gap, buttons, gap, footer
            top = max(0, min(state.scroll, len(body) - room))
            for y, (line, style) in enumerate(body[top:top + room]):
                attr = {"head": curses.A_BOLD, "dim": curses.A_DIM}.get(style, 0)
                if style == "warn":
                    attr = (menu_curses.look("auth" if agent.auth else "needs", colour) & ~curses.A_REVERSE) | curses.A_BOLD
                menu_curses.put(screen, 2 + y, 2, line, attr)
            if len(body) > room:
                more = f"{top + 1}-{min(top + room, len(body))} of {len(body)}  PgUp PgDn"
                menu_curses.put(screen, 1, max(columns - len(more) - 1, 2), more, curses.A_DIM)

            labels = menu_detail.button_labels(offered, columns - 4)
            x = 2
            for index, (button, label) in enumerate(zip(offered, labels)):
                lit = (index == state.focus and not state.typing) or state.confirm == button
                menu_curses.put(screen, height - 3, x, label, curses.A_REVERSE if lit else 0)
                spots.append((x, x + menu_render.width(label), button))
                x += menu_render.width(label) + 2
            field = columns - 6
            if "Send" in offered:
                shown = state.text[-(field - 1):] if menu_render.width(state.text) >= field else state.text
                menu_curses.put(screen, height - 5, 2, "> " + shown)
                if not state.typing and not state.text:
                    menu_curses.put(screen, height - 5, 4, "press i to type an instruction", curses.A_DIM)
            if state.confirm:
                hint = f"{state.confirm} this agent? press y or Enter to confirm · any other key cancels"
            elif state.typing:
                hint = "Enter send · Esc stop typing"
            else:
                hint = "Tab next button · Enter press · i instruction · PgUp PgDn scroll · Esc close"
            menu_curses.put(screen, height - 1, 2, menu_render.fit(note or stale or hint, columns - 4, glyphs["ellipsis"]),
                            curses.A_BOLD if note or stale else curses.A_DIM)
            menu_curses.cursor(state.typing)
            if state.typing:
                screen.move(height - 5, 4 + min(menu_render.width(state.text), field - 1))
        screen.noutrefresh()
        curses.doupdate()

        event = read_event(screen)
        if event is None:
            loaded, stale = reload(key, loaded)             # reload only when idle, never per keystroke
            continue
        if event == "resize":
            curses.update_lines_cols()
            continue
        if small:
            # Nothing is drawn but "too small": no buttons, no instruction line, no confirm hint. A key
            # here would act blind, so only closing is possible until the popup is big enough again.
            if event in (("key", "esc"), ("char", "q")):
                return
            continue
        if event[0] == "mouse":
            x, y = event[1]
            if y == height - 3:
                event = ("click", next((b for start, end, b in spots if start <= x < end), ""))
            elif y == height - 5:
                event = ("click", "input")
            else:
                continue
        note = ""
        was_armed = state.confirm
        state, chosen = menu_popup.step(state, offered, event, page=max(height - 7, 1), now=time.monotonic())
        if state.confirm and not was_armed:
            curses.flushinp()                               # whatever was pasted along with the arming key is dropped
        if not chosen:
            continue
        if chosen in menu_popup.RISKY:
            # One last guard against a paste whose chunk boundary happened to land on the confirm
            # key: if more keys are already waiting, a person did not type this.
            screen.timeout(120)
            trailing = read_event(screen)
            screen.timeout(RELOAD_MS)
            if trailing is not None:
                curses.flushinp()
                state, note = menu_popup.cancel(state), "cancelled: more keys followed, so that looked pasted"
                continue
        note, succeeded, close = menu_actions.perform(agent, chosen, state.text)
        state = menu_popup.after_action(state, chosen, succeeded)
        curses.flushinp()                                   # the rest of a paste must not run as hotkeys
        if close:
            return
        loaded, stale = reload(key, loaded)


def main(argv):
    parser = argparse.ArgumentParser(prog="agent-menu-detail", description=__doc__.split("\n")[0])
    parser.add_argument("--print", action="store_true", dest="as_text",
                        help="print the popup's content as plain text and exit. Offers no actions")
    parser.add_argument("key", help='agent key from the sidebar, "<kind>:<session id>"')
    args = parser.parse_args(argv)
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass  # the environment names a locale that is not installed: run in the default one, not crash
    if args.as_text:
        agent, parent_name, recent, reply, errors = load(args.key)
        if not agent:
            print("agent-menu-detail: no such agent" + (f" ({'; '.join(errors)})" if errors else ""), file=sys.stderr)
            return 3
        print(menu_detail.title(agent, parent_name))
        for line, _ in menu_detail.body(agent, recent, reply, 96, menu_style.glyphs()):
            print(line)
        print("buttons: " + ", ".join(menu_detail.buttons(agent)))
        return 0
    if not menu_curses.usable_terminal() or not sys.stdout.isatty():
        print("agent-menu-detail: this needs a real terminal (TERM is dumb or output is not a terminal). --print shows this agent as text.",
              file=sys.stderr)
        return 2
    curses.wrapper(run, args.key)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
