#!/usr/bin/env python3
"""agent-menu-detail: the popup for one agent. Shows what it waits on, its spawned agents and its
recent messages, and lets the owner open its pane, attach, send an instruction or retire it.
The actions run only from this interactive screen. See ../README.md, "Agent menu"."""
import argparse
import curses
import locale
import os
import subprocess
import sys

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lib"))
import agent_state  # noqa: E402
import auth_readers  # noqa: E402
import menu_actions  # noqa: E402
import menu_curses  # noqa: E402
import menu_detail  # noqa: E402
import menu_render  # noqa: E402
import menu_style  # noqa: E402
from sources import logs_src  # noqa: E402

KEYS = {"Open pane": "o", "Attach": "t", "Send": "i", "Retire": "r"}
RELOAD_MS = 1500


def load(key):
    snapshot = agent_state.collect()
    agent = snapshot.by_key.get(key)
    if not agent:
        return None, "", [], ""
    parent = snapshot.by_key.get(agent.parent_key)
    recent = logs_src.recent(agent.session_id, agent.name)
    reply = ""
    if agent.kind == "codex" and not agent.pane_id:
        done = subprocess.run([sys.executable, os.path.join(BIN, "codex-reply"), agent.session_id],
                              capture_output=True, text=True, timeout=20)
        reply = "\n".join(done.stdout.splitlines()[1:]).strip() if done.returncode in (0, 5) else ""
        agent.auth = agent.auth or (auth_readers.detect_output(reply) or "")
    return agent, (parent.name if parent else ""), recent, reply


def act(agent, button, text):
    """Returns (note for the owner, close the popup?)."""
    try:
        if button == "Open pane":
            return menu_actions.open_pane(agent), True
        if button == "Attach":
            return menu_actions.attach(agent), True
        if button == "Retire":
            return menu_actions.retire(agent), False
        if button == "Send":
            return menu_actions.instruct(agent, text), False
    except menu_actions.Refused as refusal:
        return f"not done: {refusal}", False
    return "", False


def read_key(screen):
    """(is_char, value): a typed character as str, or a curses key code as int. None on timeout.
    Wide input keeps a typed character apart from a function key and keeps non-ASCII text whole."""
    try:
        got = screen.get_wch()
    except curses.error:
        return None
    return (True, got) if isinstance(got, str) else (False, got)


def run(screen, key):
    colour = menu_curses.setup(screen)
    glyphs = menu_style.glyphs()
    screen.timeout(RELOAD_MS)
    typing, text, note, confirm, focus, scroll = False, "", "", "", 0, 0
    while True:
        agent, parent_name, recent, reply = load(key)
        height, columns = screen.getmaxyx()
        columns -= 1
        screen.erase()
        if not agent:
            menu_curses.put(screen, 1, 2, "This agent is no longer listed. Press any key.")
            screen.noutrefresh()
            curses.doupdate()
            screen.timeout(-1)
            screen.getch()
            return
        if menu_render.too_small(height, columns):
            menu_curses.put(screen, 0, 0, "too small")
            screen.noutrefresh()
            curses.doupdate()
            got = read_key(screen)
            if got and got[0] and got[1] in ("\x1b", "q"):
                return
            continue

        menu_curses.put(screen, 0, 2, menu_render.fit(menu_detail.title(agent, parent_name), columns - 4,
                                                      glyphs["ellipsis"]), curses.A_DIM)
        body = menu_detail.body(agent, recent, reply, columns - 4, glyphs)
        room = height - 7                                   # title, gap, input, buttons, gap, footer
        scroll = max(0, min(scroll, len(body) - room))
        for y, (line, style) in enumerate(body[scroll:scroll + room]):
            attr = {"head": curses.A_BOLD, "dim": curses.A_DIM}.get(style, 0)
            if style == "warn":
                attr = menu_curses.look("auth" if agent.auth else "needs", colour) & ~curses.A_REVERSE | curses.A_BOLD
            menu_curses.put(screen, 2 + y, 2, line, attr)
        if len(body) > room:
            more = f"{scroll + 1}-{min(scroll + room, len(body))} of {len(body)}  PgUp PgDn"
            menu_curses.put(screen, 1, columns - len(more) - 1, more, curses.A_DIM)

        offered, spots, x = menu_detail.buttons(agent), [], 2
        focus = min(focus, max(len(offered) - 1, 0))
        for index, button in enumerate(offered):
            label = f"[ {button} ]" if button == "Send" else f"[ {button} ({KEYS[button]}) ]"
            attr = curses.A_REVERSE if (index == focus and not typing) or confirm == button else 0
            menu_curses.put(screen, height - 3, x, label, attr | (curses.A_BOLD if index == 0 else 0))
            spots.append((x, x + menu_render.width(label), button))
            x += menu_render.width(label) + 2
        field = columns - 6
        if "Send" in offered:
            shown = text[-(field - 1):] if menu_render.width(text) >= field else text   # scrolls sideways
            menu_curses.put(screen, height - 5, 2, "> " + shown, 0 if typing or text else curses.A_DIM)
            if not typing and not text:
                menu_curses.put(screen, height - 5, 4, "press i to type an instruction", curses.A_DIM)
        if confirm:
            hint = f"press {KEYS[confirm]} or Enter again to {confirm.lower()} this agent · any other key cancels"
        elif typing:
            hint = "Enter send · Esc stop typing"
        else:
            hint = "Tab next button · Enter press · i instruction · PgUp PgDn scroll · Esc close"
        menu_curses.put(screen, height - 1, 2, menu_render.fit(note or hint, columns - 4, glyphs["ellipsis"]),
                        curses.A_BOLD if note else curses.A_DIM)
        curses.curs_set(1 if typing else 0)
        if typing:
            screen.move(height - 5, 4 + min(menu_render.width(text), field - 1))
        screen.noutrefresh()
        curses.doupdate()

        got = read_key(screen)
        if got is None:
            continue
        is_char, value = got
        char = value if is_char else ""
        pressed = -1 if is_char else value
        if pressed == curses.KEY_RESIZE:
            curses.update_lines_cols()
            continue
        chosen = ""
        if pressed == curses.KEY_MOUSE:
            try:
                _, mx, my, _, _ = curses.getmouse()
            except curses.error:
                continue
            if my == height - 3:
                chosen = next((b for start, end, b in spots if start <= mx < end), "")
            elif my == height - 5 and "Send" in offered:
                typing = True
                continue
        elif typing:
            if char == "\x1b":
                typing = False
            elif char in ("\n", "\r") or pressed == curses.KEY_ENTER:
                chosen, typing = "Send", False
            elif char in ("\x7f", "\x08") or pressed == curses.KEY_BACKSPACE:
                text = text[:-1]
            elif char and char.isprintable():
                text += char
            if not chosen:
                note = ""
                continue
        elif char in ("\x1b", "q"):
            return
        elif pressed == curses.KEY_NPAGE:
            scroll += room
            continue
        elif pressed == curses.KEY_PPAGE:
            scroll -= room
            continue
        elif (char == "\t" or pressed == curses.KEY_RIGHT) and offered:
            focus = (focus + 1) % len(offered)
            continue
        elif pressed in (curses.KEY_BTAB, curses.KEY_LEFT) and offered:
            focus = (focus - 1) % len(offered)
            continue
        elif char == "i" and "Send" in offered:
            typing, note = True, ""
            continue
        elif (char in ("\n", "\r") or pressed == curses.KEY_ENTER) and offered:
            chosen = confirm or offered[focus]
        else:
            chosen = next((b for b, k in KEYS.items() if char == k and b in offered and b != "Send"), "")
        if not chosen:
            confirm, note = "", ""
            continue
        if chosen == "Send" and not text.strip():
            typing = True                                   # Enter on an empty Send starts typing
            continue
        if chosen == "Retire" and confirm != "Retire":
            confirm, note = "Retire", ""                    # the only risky action, so the only one asked twice
            continue
        note, close = act(agent, chosen, text)
        confirm = ""
        if chosen == "Send" and not note.startswith("not done"):
            text = ""
        if close:
            return


def main(argv):
    parser = argparse.ArgumentParser(prog="agent-menu-detail", description=__doc__.split("\n")[0])
    parser.add_argument("--print", action="store_true", dest="as_text",
                        help="print the popup's content as plain text and exit. Offers no actions")
    parser.add_argument("key", help='agent key from the sidebar, "<kind>:<session id>"')
    args = parser.parse_args(argv)
    locale.setlocale(locale.LC_ALL, "")
    if args.as_text:
        agent, parent_name, recent, reply = load(args.key)
        if not agent:
            print("agent-menu-detail: no such agent", file=sys.stderr)
            return 3
        print(menu_detail.title(agent, parent_name))
        for line, _ in menu_detail.body(agent, recent, reply, 96, menu_style.glyphs()):
            print(line)
        print("buttons: " + ", ".join(menu_detail.buttons(agent)))
        return 0
    curses.wrapper(run, args.key)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
