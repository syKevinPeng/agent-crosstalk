#!/usr/bin/env python3
"""agent-menu: a tmux sidebar that shows every Claude and Codex agent on this machine, who spawned
whom, and who is waiting for you. Click a row or press Enter for the detail popup.
Refreshing reads local state only and spends no tokens. See ../README.md, "Agent menu"."""
import argparse
import curses
import locale
import os
import shlex
import sys
import threading
import time

BIN = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(BIN), "lib"))
import agent_state  # noqa: E402
import menu_curses  # noqa: E402
import menu_render  # noqa: E402
import menu_style  # noqa: E402
from sources import limits_src, tmux_src  # noqa: E402
from sources.base import SourceError  # noqa: E402

REFRESH_SECONDS = 2.0
LIMITS_SECONDS = 15 * 60   # rate limits move slowly, and each Claude reading leaves a transcript file
TICK_MS = 150
# tmux starts the popup with the server's environment, not this process's. These settings decide what
# the popup offers (look-only mode above all) and which logs and programs it uses, so the popup's
# command line carries them over.
POPUP_ENV = ("AGENT_MENU_LOOK_ONLY", "AGENT_MENU_ASCII", "AGENT_MENU_NO_ANIMATION", "NO_COLOR", "FORCE_COLOR",
             "LANG", "LC_ALL", "LC_CTYPE", "PATH", "AGENT_MENU_ACTIONS_LOG", "AGENT_MENU_PROC_ROOT",
             "AGENT_COMMS_LOG", "AGENT_COMMS_SPAWN_LOG", "TMUX_BIN", "CLAUDE_BIN", "CODEX_BIN",
             "CODEX_APP_SERVER_SOCK")
ACTIONS = {curses.KEY_DOWN: "down", ord("j"): "down", curses.KEY_UP: "up", ord("k"): "up",
           curses.KEY_RIGHT: "right", ord("l"): "right", curses.KEY_LEFT: "left", ord("h"): "left",
           curses.KEY_HOME: "home", ord("g"): "home", curses.KEY_END: "end", ord("G"): "end", ord(" "): "toggle"}


class LimitsPoller(threading.Thread):
    """Reads the rate limits on its own slow clock. Separate from the tree, because the Claude
    reading takes a few seconds and the tree must keep refreshing while it runs."""

    def __init__(self):
        super().__init__(daemon=True)
        self.limits, self.errors, self.taken_at, self.wake = [], [], None, threading.Event()

    def run(self):
        while True:
            limits, errors = limits_src.read_all()
            if limits or not self.limits:        # a failed reading never replaces a good one silently
                self.limits, self.taken_at = limits, time.time()
            self.errors = errors
            self.wake.wait(LIMITS_SECONDS)
            self.wake.clear()


class Poller(threading.Thread):
    """Collects off the draw path, so a slow source never freezes the keys. It never touches curses."""

    def __init__(self):
        super().__init__(daemon=True)
        self.snapshot, self.wake, self.show_quit = None, threading.Event(), False

    def run(self):
        while True:
            self.snapshot = agent_state.safe_collect(include_quit=self.show_quit)
            self.wake.wait(REFRESH_SECONDS)
            self.wake.clear()


def detail_command(key, environ=None):
    """The popup's shell command, with this process's POPUP_ENV settings passed through `env`."""
    environ = os.environ if environ is None else environ
    settings = [f"{name}={environ[name]}" for name in POPUP_ENV if name in environ]
    parts = (["env", *settings] if settings else []) + [sys.executable, os.path.join(BIN, "agent-menu-detail"), key]
    return " ".join(shlex.quote(part) for part in parts)


def open_detail(agent):
    try:
        tmux_src.popup(detail_command(agent.key), title=f" {agent.name} ")
    except SourceError as exc:
        return str(exc)
    return ""


def show_help(screen):
    screen.erase()
    lines = menu_render.HELP_ASCII if menu_style.use_ascii() else menu_render.HELP
    for y, line in enumerate(lines[:curses.LINES - 1]):
        menu_curses.put(screen, y, 1, menu_render.fit(line, curses.COLS - 2), curses.A_BOLD if y == 0 else 0)
    screen.noutrefresh()
    curses.doupdate()
    screen.timeout(-1)
    screen.getch()
    screen.timeout(TICK_MS)


def run(screen):
    menu_curses.cursor(False)
    colour = menu_curses.setup(screen)
    glyphs = menu_style.glyphs()
    moving = menu_style.animate()
    screen.timeout(TICK_MS)
    poller = Poller()
    poller.start()
    limits = LimitsPoller()
    limits.start()
    selected, collapsed, note, frame, top = "", set(), "", 0, 0
    while True:
        height, full_width = screen.getmaxyx()
        columns = full_width - 1  # never write the last column: some terminals wrap there
        snapshot = poller.snapshot
        frame += 1 if moving else 0
        screen.erase()
        if menu_render.too_small(height, full_width):
            menu_curses.put(screen, 0, 0, menu_render.fit("too small", max(columns, 1)))
            rendered = []
        elif not snapshot:
            rendered = []
            menu_curses.put(screen, 0, 0, " AGENTS  loading", curses.A_BOLD)
        else:
            selected, collapsed = menu_render.move(snapshot, collapsed, selected, "stay")
            rendered = menu_render.rows(snapshot, columns, collapsed, glyphs, frame // 2)
            pinned = rendered[:menu_render.pinned_count(rendered)]
            block = menu_render.limit_rows(limits.limits, columns, glyphs, limits.taken_at,
                                           time.time(), limits.errors)
            if height - 1 - len(block) < len(pinned) + 3:
                block = []                       # a short pane shows agents, not limits
            for y, row in enumerate(block):
                attr = curses.A_DIM if row["look"] == "faint" else (
                    (menu_curses.look("auth", colour) & ~curses.A_REVERSE) | curses.A_BOLD if row["look"] else 0)
                menu_curses.put(screen, height - 1 - len(block) + y, 0, row["text"], attr)
            room = height - 1 - len(block) - len(pinned)
            top = menu_render.scroll_top(rendered, selected, room, top)
            on_screen = pinned + rendered[len(pinned) + top:len(pinned) + top + max(room, 0)]
            rendered = on_screen               # from here on, row y on screen is rendered[y]: clicks map right
            cursor_row = 0
            for y, row in enumerate(on_screen):
                attr = {"header": curses.A_BOLD, "retired": curses.A_DIM, "quit": curses.A_DIM,
                        "quitdiv": curses.A_DIM | curses.A_BOLD}.get(row["style"], 0)
                if row["style"] == "error":
                    attr = menu_curses.look("auth", colour)
                chosen = row["key"] and row["key"] == selected
                if chosen:
                    attr, cursor_row = attr | curses.A_REVERSE, y
                menu_curses.put(screen, y, 0, row["text"].ljust(columns) if chosen else row["text"], attr)
                if row["mark"] and not chosen and row["style"] == "row":
                    start = menu_render.width(row["text"]) - menu_render.width(row["mark"])
                    menu_curses.put(screen, y, start, row["mark"], menu_curses.look(row["look"], colour))
            menu_curses.put(screen, height - 1, 0, menu_render.footer(columns, note, glyphs), curses.A_DIM)
            screen.move(cursor_row, 0)  # keep the cursor on the selection: screen readers follow it
        screen.noutrefresh()
        curses.doupdate()

        pressed = screen.getch()
        if pressed == -1:
            continue
        note = ""
        if pressed == curses.KEY_RESIZE:
            curses.update_lines_cols()
            continue
        if pressed in (ord("q"), ord("Q")):
            return
        if pressed == ord("?"):
            show_help(screen)
            continue
        if pressed in (ord("w"), ord("W")):
            pane = os.environ.get("TMUX_PANE")
            if not pane:
                note = "not running in a tmux pane"
            else:
                try:
                    target = menu_render.resize_target(columns)
                    tmux_src.resize(pane, target)
                except SourceError as exc:
                    note = str(exc)
            continue
        if pressed in (ord("a"), ord("A")):
            poller.show_quit = not poller.show_quit
            note = "showing quit agents" if poller.show_quit else "hiding quit agents"
            poller.wake.set()
            continue
        if pressed in (ord("u"), ord("U")):
            note = "updating limits…"
            limits.wake.set()
            continue
        if not snapshot:
            continue
        target = ""
        if pressed in ACTIONS:
            selected, collapsed = menu_render.move(snapshot, collapsed, selected, ACTIONS[pressed])
        elif pressed in (curses.KEY_ENTER, 10, 13):
            target = selected
        elif pressed == curses.KEY_MOUSE:
            spot = menu_curses.click()
            if not spot:
                continue                   # a release or a wheel turn: only a press or click opens or folds
            x, y = spot
            key = menu_render.key_at(rendered, y)
            if not key:
                continue
            selected = key
            if x <= 3 and snapshot.by_key[key].children:
                selected, collapsed = menu_render.move(snapshot, collapsed, key, "toggle")
            else:
                target = key
        if target in snapshot.by_key:
            note = open_detail(snapshot.by_key[target])
            poller.wake.set()


def main(argv):
    parser = argparse.ArgumentParser(prog="agent-menu", description=__doc__.split("\n")[0])
    parser.add_argument("--once", action="store_true", help="print the tree once as plain text and exit")
    parser.add_argument("--columns", type=int, default=34, help="with --once: width to render (default 34)")
    args = parser.parse_args(argv)
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass  # the environment names a locale that is not installed: run in the default one, not crash
    if args.once:
        for row in menu_render.rows(agent_state.collect(), args.columns, glyphs=menu_style.glyphs()):
            print(row["text"])
        return 0
    if not menu_curses.usable_terminal() or not sys.stdout.isatty():
        print("agent-menu: this needs a real terminal (TERM is dumb or output is not a terminal). --once prints the tree as text.",
              file=sys.stderr)
        return 2
    curses.wrapper(run)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
